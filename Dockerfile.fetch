# syntax=docker/dockerfile:1

# Modified by Directum, 2026

ARG DEBIAN_VERSION=trixie
ARG PYTHON_VERSION=3.13
ARG POETRY_VERSION=2.2.1

# 1. Берем компилятор Rust для подготовки vendor-папки
FROM docker.io/library/rust:slim-${DEBIAN_VERSION} AS rust-toolchain

# 2. Генерируем requirements.txt
FROM --platform=$BUILDPLATFORM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-${DEBIAN_VERSION} AS requirements
WORKDIR /synapse
COPY pyproject.toml poetry.lock /synapse/
ENV UV_LINK_MODE=copy
ARG POETRY_VERSION
# HACK: китайское зеркало, без него не проходит TODO: настроить на билд машине доступ, либо оставить
ARG MIRROR_HOST="pypi.tuna.tsinghua.edu.cn"
ENV UV_DEFAULT_INDEX="https://${MIRROR_HOST}/simple/"
RUN uvx --with poetry-plugin-export==1.9.0 \
        poetry@${POETRY_VERSION} export --extras all --without-hashes -o /synapse/requirements.txt

# 3. Скачиваем Python-пакеты и Rust-крейты
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-${DEBIAN_VERSION} AS fetch-deps

ENV RUSTUP_HOME=/rust
ENV CARGO_HOME=/cargo
ENV PATH=/cargo/bin:/rust/bin:$PATH

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential libffi-dev libssl-dev libpq-dev libjpeg-dev libwebp-dev libxmlsec1-dev pkg-config git

COPY --from=rust-toolchain /usr/local/rustup /rust
COPY --from=rust-toolchain /usr/local/cargo /cargo
COPY --from=requirements /synapse/requirements.txt /synapse/requirements.txt
COPY synapse /synapse/synapse/
COPY rust /synapse/rust/
COPY pyproject.toml README.rst build_rust.py Cargo.toml Cargo.lock /synapse/

WORKDIR /synapse
# Скачиваем все библиотеки из requirements.txt в кэш
# HACK: китайское зеркало, без него не проходит TODO: настроить на билд машине доступ, либо оставить
ARG MIRROR_HOST="pypi.tuna.tsinghua.edu.cn"
ENV PIP_INDEX_URL="https://${MIRROR_HOST}/simple/"
RUN mkdir -p /wheels && \
    pip wheel --wheel-dir=/wheels -r /synapse/requirements.txt && \
    pip wheel --wheel-dir=/wheels poetry-core setuptools-rust maturin wheel build
# Выгружаем исходники Rust-крейтов в папку /vendor
RUN cargo vendor /vendor

# 4. Скачиваем и распаковываем системные библиотеки Debian с сохранением симлинков
FROM --platform=$BUILDPLATFORM docker.io/library/debian:${DEBIAN_VERSION} AS runtime-deps
RUN dpkg --add-architecture arm64
RUN dpkg --add-architecture amd64
RUN \
  apt-get update -qq && \
  apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances --no-pre-depends \
      curl \
      gosu \
      libjpeg62-turbo \
      libpq5 \
      libwebp7 \
      xmlsec1 \
      libjemalloc2 \
    | grep '^\w' > /tmp/pkg-list && \
  for arch in arm64 amd64; do \
    mkdir -p /tmp/debs-${arch} && \
    chown _apt:root /tmp/debs-${arch} && \
    cd /tmp/debs-${arch} && \
    apt-get -o APT::Architecture="${arch}" download $(cat /tmp/pkg-list); \
  done

RUN \
  for arch in arm64 amd64; do \
    mkdir -p /install-${arch}/var/lib/dpkg/status.d/ && \
    for deb in /tmp/debs-${arch}/*.deb; do \
      package_name=$(dpkg-deb -I ${deb} | awk '/^ Package: .*$/ {print $2}'); \
      echo "Extracting: ${package_name}"; \
      dpkg --ctrl-tarfile $deb | tar -Ox ./control > /install-${arch}/var/lib/dpkg/status.d/${package_name}; \
      dpkg --extract $deb /install-${arch}; \
    done; \
  done

RUN mkdir -p /out && tar -cf /out/debian-libs.tar /install-amd64 /install-arm64

# 5. Выгружаем все папки и архив системных ссылок на жесткий диск ПК
FROM scratch
COPY --from=requirements /synapse/requirements.txt /requirements.txt
COPY --from=fetch-deps /wheels /wheels
COPY --from=fetch-deps /vendor /vendor
COPY --from=runtime-deps /out/debian-libs.tar /debian-libs.tar
