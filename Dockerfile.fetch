# syntax=docker/dockerfile:1

# Modified by Directum, 2026
#
# Этап 1 (онлайн): всё собирается на базовом образе Directum (ALT Linux, glibc 2.32), чтобы
# скомпилированные расширения (Rust, psycopg2, xmlsec и др.) работали в итоговом образе.
# На выходе (в docker/offline-cache):
#   requirements.txt - зафиксированные зависимости Synapse
#   wheels/          - готовые wheel-файлы всех зависимостей и самого Synapse (вместе с pip)
#   rpms/            - rpm-пакеты ALT для итогового образа (Python, curl, gosu, библиотеки)

ARG BASE_IMAGE=devregistry.directum.ru/directum/rx-base/pango:26.3.fstek
ARG POETRY_VERSION=2.2.1

# Бинарник uv используется только для создания venv с pip и установки poetry
FROM ghcr.io/astral-sh/uv:python3.13-trixie AS uv-bin

FROM ${BASE_IMAGE} AS fetch

ARG POETRY_VERSION
# HACK: китайское зеркало, без него не проходит TODO: настроить на билд машине доступ, либо оставить
ARG MIRROR_HOST="pypi.tuna.tsinghua.edu.cn"
ENV UV_DEFAULT_INDEX="https://${MIRROR_HOST}/simple/"
ENV PIP_INDEX_URL="https://${MIRROR_HOST}/simple/"
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=never

# Пакеты, которые нужны в итоговом образе (во время работы Synapse)
ARG RUNTIME_PACKAGES="python3.12 python3.12-modules-sqlite3 curl gosu libpq5 libwebp7 libjpeg libxmlsec1 libxmlsec1-openssl libjemalloc2"
# Пакеты, которые нужны только для сборки wheel-файлов
ARG BUILD_PACKAGES="python3.12-dev gcc make rust rust-cargo pkg-config git libffi-devel libssl-devel libpq5-devel libjpeg-devel libwebp-devel libxmlsec1-devel libxmlsec1-openssl-devel"

# Сначала только скачиваем rpm-пакеты для итогового образа и сохраняем их для офлайн-сборки
RUN apt-get update -qq && \
    apt-get install -y --download-only ${RUNTIME_PACKAGES} && \
    mkdir -p /out/rpms && \
    cp /var/cache/apt/archives/*.rpm /out/rpms/ && \
    apt-get install -y ${RUNTIME_PACKAGES} ${BUILD_PACKAGES} && \
    rustc --version && cargo --version

COPY --from=uv-bin /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# venv на Python 3.12 с pip и poetry (экспорт зависимостей)
RUN uv venv --seed --python /usr/bin/python3.12 /venv && \
    /venv/bin/pip install "poetry==${POETRY_VERSION}" "poetry-plugin-export==1.9.0"

WORKDIR /synapse
COPY pyproject.toml poetry.lock /synapse/
RUN /venv/bin/poetry export --extras all --without-hashes -o /synapse/requirements.txt

COPY synapse /synapse/synapse/
COPY rust /synapse/rust/
COPY README.rst build_rust.py Cargo.toml Cargo.lock /synapse/

# Собираем wheel-файлы зависимостей, самого pip и Synapse (вместе с Rust-модулями)
RUN mkdir -p /wheels && \
    /venv/bin/pip wheel --wheel-dir=/wheels -r /synapse/requirements.txt && \
    /venv/bin/pip wheel --wheel-dir=/wheels pip && \
    /venv/bin/pip wheel --wheel-dir=/wheels --no-deps /synapse

# Выгружаем результат на диск
FROM scratch
COPY --from=fetch /synapse/requirements.txt /requirements.txt
COPY --from=fetch /wheels /wheels
COPY --from=fetch /out/rpms /rpms