# syntax=docker/dockerfile:1

# Modified by Directum, 2026
#
# Этап 2 (офлайн): итоговый образ на базовом образе Directum (ALT Linux).
# Всё необходимое берётся из docker/offline-cache, подготовленного Dockerfile.fetch.

ARG RUNTIME_IMAGE=devregistry.directum.ru/directum/rx-base/pango:26.3.fstek
FROM ${RUNTIME_IMAGE}

ARG SYNAPSE_VERSION_STRING
ENV SYNAPSE_VERSION_STRING=${SYNAPSE_VERSION_STRING}

LABEL org.opencontainers.image.url='https://github.com/element-hq/synapse'
LABEL org.opencontainers.image.documentation='https://element-hq.github.io/synapse/latest/'
LABEL org.opencontainers.image.source='https://github.com/DirectumCompany/synapse-custom'
LABEL org.opencontainers.image.licenses='AGPL-3.0-or-later'
LABEL org.opencontainers.image.vendor='Directum'
LABEL org.opencontainers.image.description='Custom multi-stage build of Matrix Synapse based on https://github.com/element-hq/synapse'

# Системные пакеты (Python 3.12, curl, gosu, библиотеки) из заранее скачанных rpm
COPY docker/offline-cache/rpms /tmp/rpms
RUN rpm -Uvh --replacepkgs /tmp/rpms/*.rpm && rm -rf /tmp/rpms && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python3

# start.py запускает /usr/sbin/gosu (путь Debian), в ALT он лежит в /usr/bin
RUN ln -sf /usr/bin/gosu /usr/sbin/gosu

# Python-зависимости и Synapse строго из локальной папки wheels (pip запускается из собственного wheel)
COPY docker/offline-cache/wheels /wheels
COPY docker/offline-cache/requirements.txt /offline/requirements.txt
RUN export PYTHONPATH="$(ls /wheels/pip-*.whl | head -n 1)" && \
    python -m pip install --no-index --find-links=/wheels --no-deps -r /offline/requirements.txt && \
    python -m pip install --no-index --find-links=/wheels --no-deps /wheels/matrix_synapse-*.whl && \
    rm -rf /wheels /offline

# jemalloc: start.py ищет библиотеку по пути Debian, на ALT делаем ссылку
RUN set -e; \
    for f in /usr/lib64/libjemalloc.so.2 /usr/lib/libjemalloc.so.2; do \
      if [ -f "$f" ]; then mkdir -p /usr/lib/x86_64-linux-gnu && ln -sf "$f" /usr/lib/x86_64-linux-gnu/libjemalloc.so.2; break; fi; \
    done

COPY ./docker/start.py /start.py
COPY ./docker/conf /conf

EXPOSE 8008/tcp 8448/tcp
EXPOSE 19090/tcp

ENTRYPOINT ["/start.py"]

HEALTHCHECK --start-period=5s --interval=15s --timeout=5s \
  CMD curl -fSs http://localhost:8008/health || exit 1